          "id": "extract+synthesize",
          "replace": [
            "extract",
            "synthesize"
          ],
          "into": {
            "id": "extract_synthesize",
            "role": "worker"
          },
          "setting": {
            "harness": "api",
            "model": {
              "id": "claude-opus-5-5"
            },
            "effort": "high",
            "options": {
              "prompt": "merged-v1"
