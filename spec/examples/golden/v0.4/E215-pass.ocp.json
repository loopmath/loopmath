      {
        "id": "j-astra",
        "kind": "model",
        "model": {
          "id": "gpt-6-astra"
        },
        "rubric": "rubric.md#v1"
      },
      {
        "id": "person",
        "kind": "person",
        "rate": 0.2
      }
